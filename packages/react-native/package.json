{
  "name": "@mobile-observability/react-native",
  "version": "0.3.0",
  "description": "Crash reporting, error grouping, startup/screen performance and network monitoring for Expo and React Native apps.",
  "keywords": [
    "react-native",
    "expo",
    "crash-reporting",
    "error-tracking",
    "performance",
    "observability",
    "monitoring",
    "expo-observe"
  ],
  "license": "MIT",
  "author": "mobile-observability",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emmadal/mobile-observability.git",
    "directory": "packages/react-native"
  },
  "homepage": "https://github.com/emmadal/mobile-observability",
  "bugs": "https://github.com/emmadal/mobile-observability/issues",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "react-native": "src/index.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./build/index.js"
    },
    "./integrations/react-navigation": {
      "types": "./build/integrations/react-navigation.d.ts",
      "react-native": "./src/integrations/react-navigation.tsx",
      "default": "./build/integrations/react-navigation.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "src",
    "ios",
    "android/build.gradle",
    "android/src",
    "expo-module.config.json",
    "!**/__tests__",
    "!**/*.test.*",
    "!android/src/test",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('build',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@mobile-observability/protocol": "workspace:*",
    "fflate": "^0.8.3"
  },
  "peerDependencies": {
    "expo": ">=56",
    "react": ">=19",
    "react-native": ">=0.83",
    "expo-router": ">=56",
    "@react-navigation/native": ">=7"
  },
  "peerDependenciesMeta": {
    "expo-router": {
      "optional": true
    },
    "@react-navigation/native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "~19.3.0",
    "expo": "~58.0.26",
    "jsdom": "^27.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "typescript": "~6.0.3",
    "vitest": "^5.1.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
