# Postgres (docker compose up -d db)
DATABASE_URL=postgres://mobs:mobs@localhost:5433/mobs
# Test database used by integration tests (created automatically)
TEST_DATABASE_URL=postgres://mobs:mobs@localhost:5433/mobs_test
# Better Auth: generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=replace-me-with-a-32-byte-secret
BETTER_AUTH_URL=http://localhost:3000
# Set to true once a mail provider is wired in src/lib/auth/mailer.ts
# (invitees must then prove email ownership).
MAIL_PROVIDER_CONFIGURED=false
# Optional: log verification/invite links to stdout even in production.
MAIL_LOG_LINKS=false
